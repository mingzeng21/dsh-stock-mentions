{
  "name": "dsh-stock-mentions",
  "version": "0.1.0",
  "description": "DSH settled assistant Markdown annotations for Shanghai and Shenzhen A-shares",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests",
    "build": "tsc -p tsconfig.json && tsdown --config tsdown.config.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run verify:package",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.4",
    "@deepseek-ai/dsh-client-connection": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-client-runtime": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.0.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.1-rc.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true },
    "@deepseek-ai/dsh-client-ui-layout": { "optional": true },
    "@deepseek-ai/dsh-client-ui-primitives": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "lightningcss": "1.32.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@deepseek-ai/dsh-client-locale": "^0.0.1-rc.5",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.en.md", "CONTEXT.md", "docs", "LICENSE"]
}
